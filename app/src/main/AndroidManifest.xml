<?xml version="1.0" encoding="utf-8"?>
<!--
  Every permission here must be justified. Current list:
  - ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION: only requested when the user taps
    "Use current location". Precise (fine) is needed for GPS, the only source that works
    without internet. Coarse alone is allowed; the app then tries other location sources.
    No background location is ever requested. The location never leaves the device.
  - POST_NOTIFICATIONS: shows the "Azan playing" notification with a Stop button. Asked for in
    the app (Android 13+); the Azan still plays without it, but the notification is hidden.
  - USE_EXACT_ALARM (Android 13+) / SCHEDULE_EXACT_ALARM (Android 12 only): lets the Azan start
    at the exact minute. Playing the Azan at prayer times is this app's core alarm function, which
    is what USE_EXACT_ALARM is for; it is granted at install. Without an exact alarm Android
    delivers the alarm late AND refuses to start the Azan player from the background, so the
    Azan would stay silent (found in the Stage 12 fresh-install test: Android 13+ does not grant
    SCHEDULE_EXACT_ALARM to new installs). Android 12 grants SCHEDULE_EXACT_ALARM by default
    but the user can turn it off; the app then warns and links to the setting.
    Android 8-11 need no permission for exact alarms.
  - RECEIVE_BOOT_COMPLETED: alarms are cleared when the phone restarts; this lets the app
    schedule the next prayer times again.
  - FOREGROUND_SERVICE / FOREGROUND_SERVICE_MEDIA_PLAYBACK: lets the Azan keep playing while the
    app is closed or the screen is locked, with a visible notification.
  - WAKE_LOCK: keeps the processor awake while the Azan plays with the screen off.
  Backup: settings include the user's location, so allowBackup="false" (Android 11 and
  older) and dataExtractionRules (Android 12+) keep all app data out of cloud backup and
  phone-to-phone transfer. This app keeps all data on the device.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Location hardware is optional: users can always pick a city or type coordinates. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />

    <application
        android:name=".UniversalAzanApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UniversalAzan">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the app's own prayer alarms from AlarmManager. Not reachable by other apps. -->
        <receiver
            android:name=".alarms.PrayerAlarmReceiver"
            android:exported="false" />

        <!-- Re-schedules alarms after restart, clock/time-zone change, app update or permission change.
             These are protected system broadcasts that other apps cannot send. -->
        <receiver
            android:name=".alarms.SystemEventsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Plays the Azan in the background with a notification. -->
        <service
            android:name=".alarms.AzanPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
